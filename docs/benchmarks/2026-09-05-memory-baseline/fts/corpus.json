    {
      "id": "cache-expiry",
      "title": "Juniper cache expiry",
      "body": "Juniper keeps cached responses for 45 seconds. After that duration it fetches a fresh response.",
      "project": "juniper"
    },
    {
      "id": "retry-policy",
      "title": "Cedar retry policy",
      "body": "Cedar retries a failed download four times, then leaves the item in a visible error queue. It never silently drops the item.",
      "project": "cedar"
    },
    {
      "id": "command",
      "title": "Quartz verification command",
      "body": "To verify Quartz before release, run quartz-check --strict. The permissive mode does not validate source signatures.",
      "project": "quartz"
    },
    {
      "id": "signal",
      "title": "Walnut lock failure",
      "body": "In Walnut, LockLeaseExpired means the lease heartbeat was lost. Recovery is to renew the lease before retrying the transaction.",
      "project": "walnut"
    },
    {
      "id": "path",
      "title": "Larch checkpoint path",
      "body": "Larch stores portable checkpoints in state/handoff.json. Temporary build logs live elsewhere.",
