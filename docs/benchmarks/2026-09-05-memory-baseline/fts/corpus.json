      "body": "Willow processes 32 documents in each import batch to keep transactions short.",
      "project": "willow"
    },
    {
      "id": "timeout",
      "title": "Elm connection timeout",
      "body": "Elm abandons a connection attempt after 18 seconds. Read timeout and total job timeout are different settings.",
      "project": "elm"
    },
    {
      "id": "retention",
      "title": "Pine backup retention",
      "body": "Pine retains 14 daily backups locally. Monthly archives are stored separately.",
