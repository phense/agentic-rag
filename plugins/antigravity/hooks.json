{
  "agentic-rag": {
    "PreInvocation": [
      {
        "command": "python3 -m agentic_rag.plugins.lifecycle --host antigravity --event PreInvocation",
        "timeout": 5,
        "type": "command"
      }
    ],
    "SessionStart": [
      {
        "command": "python3 -m agentic_rag.plugins.lifecycle --host antigravity --event SessionStart",
        "timeout": 10,
        "type": "command"
      }
    ],
    "Stop": [
      {
        "command": "python3 -m agentic_rag.plugins.lifecycle --host antigravity --event Stop",
        "timeout": 30,
        "type": "command"
      }
    ],
    "enabled": true
  }
}
