# Render MODEL_USER, MODEL_GROUP, MODEL_STORE and OLLAMA_BIN from the running
# primary daemon before installation; see PB06801. No model pull is permitted.
[Unit]
Description=Agentic RAG optional background Ollama
After=network.target

[Service]
User=MODEL_USER
Group=MODEL_GROUP
StateDirectory=agentic-rag-ollama-background
StateDirectoryMode=0700
Environment=HOME=/var/lib/agentic-rag-ollama-background
Environment=OLLAMA_HOST=127.0.0.1:11436
Environment="OLLAMA_MODELS=MODEL_STORE"
Environment=OLLAMA_NOPRUNE=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
ExecStart=OLLAMA_BIN serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
CPUQuota=100%
CPUWeight=1
MemoryHigh=2G
MemoryMax=2G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=MODEL_STORE
ReadWritePaths=/var/lib/agentic-rag-ollama-background
UMask=0077

[Install]
WantedBy=multi-user.target
