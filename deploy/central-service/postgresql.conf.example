# Dedicated PG17 instance only. Merge with the operator's existing settings.
# Never expose PostgreSQL on the public or tailnet interface.
listen_addresses = ''
# Register pgvector's USERSET hnsw.* parameters before strict non-superuser
# restore creates functions with SET hnsw.ef_search. Match the source extension.
shared_preload_libraries = 'vector'
max_connections = 32
shared_buffers = '512MB'
work_mem = '8MB'
maintenance_work_mem = '128MB'
max_parallel_workers_per_gather = 0
temp_file_limit = '128MB'
statement_timeout = '30s'
# Inference runs outside PostgreSQL but may retain a gateway transaction.
# Allow the configured 300s extraction and a 256-input embedding page (up to
# eight sequential 120s HTTP rounds with two inference threads). Keep this
# finite; reassess it when increasing provider/batch limits. This is unrelated
# to the API's 30s TCP keep-alive or 5s request-body deadline.
idle_in_transaction_session_timeout = '30min'
max_wal_size = '512MB'
min_wal_size = '128MB'
# max_wal_size is a checkpoint target, NOT a hard disk cap. Do not configure
# unused replication slots or an unbounded failing archive_command.
max_slot_wal_keep_size = '512MB'
autovacuum = on
logging_collector = off
