# systemctl edit ollama; requires service restart during an authorized window.
[Service]
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_MAX_QUEUE=8
Environment=OLLAMA_KEEP_ALIVE=5m
# Keep the soft limit at the hard cap until the model's actual peak is measured.
# A 1536M soft limit caused sustained reclaim and embedding timeouts for bge-m3-q8
# even with free host RAM. The unchanged 2G hard cap still bounds this example.
MemoryHigh=2G
MemoryMax=2G
TasksMax=64
